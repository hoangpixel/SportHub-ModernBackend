// =======================================================
// SPORTHUB DATABASE - 4 MEMBERS VERSION
// ASP.NET Core Web API + React + EF Core + LINQ + MySQL
// Tổng cộng: 24 bảng
// =======================================================


// =======================================================
// 1. USERS
// =======================================================

Table users {
  id int [pk, increment]

  username varchar(100) [not null, unique]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]

  status varchar(30) [not null, default: 'ACTIVE']

  created_at datetime [not null]
  updated_at datetime
}


// =======================================================
// 2. ROLES
// =======================================================

Table roles {
  id int [pk, increment]

  name varchar(50) [not null, unique]
  description varchar(255)

  created_at datetime
}


// =======================================================
// 3. PERMISSIONS
// Quyền chi tiết dùng cho Policy-Based Authorization
// =======================================================

Table permissions {
  id int [pk, increment]

  name varchar(100) [not null, unique]
  description varchar(255)

  created_at datetime [not null]
}


// =======================================================
// 4. USER_ROLES
// =======================================================

Table user_roles {
  id int [pk, increment]

  user_id int [not null]
  role_id int [not null]

  created_at datetime

  indexes {
    (user_id, role_id) [unique]
  }
}


// =======================================================
// 5. ROLE_PERMISSIONS
// Quan hệ nhiều-nhiều giữa roles và permissions
// =======================================================

Table role_permissions {
  id int [pk, increment]

  role_id int [not null]
  permission_id int [not null]

  created_at datetime [not null]

  indexes {
    (role_id, permission_id) [unique]
    role_id
    permission_id
  }
}


// =======================================================
// 6. USER_PROFILES
// =======================================================

Table user_profiles {
  id int [pk, increment]

  user_id int [not null, unique]

  full_name varchar(150)
  phone varchar(20)
  gender varchar(20)
  date_of_birth date

  avatar_url varchar(500)

  address varchar(255)
  city varchar(100)

  created_at datetime
  updated_at datetime
}


// =======================================================
// 7. SPORTS
// =======================================================

Table sports {
  id int [pk, increment]

  name varchar(100) [not null, unique]
  description text
  icon_url varchar(500)

  status varchar(30) [default: 'ACTIVE']

  created_at datetime
  updated_at datetime
}


// =======================================================
// 8. VENUES
// Cơ sở thể thao
// =======================================================

Table venues {
  id int [pk, increment]

  owner_id int [not null]

  name varchar(200) [not null]
  description text

  // Bản 4 người gộp venue_images vào đây
  image_url varchar(500)

  address varchar(255) [not null]
  ward varchar(100)
  district varchar(100)
  city varchar(100)

  latitude decimal(10,7)
  longitude decimal(10,7)

  phone varchar(20)

  open_time time
  close_time time

  status varchar(30) [default: 'ACTIVE']

  created_at datetime
  updated_at datetime
}


// =======================================================
// 9. COURTS
// Sân cụ thể
// =======================================================

Table courts {
  id int [pk, increment]

  venue_id int [not null]
  sport_id int [not null]

  name varchar(150) [not null]
  description text

  // Bản 4 người gộp court_images vào đây
  image_url varchar(500)

  court_type varchar(100)
  capacity int

  status varchar(30) [default: 'AVAILABLE']

  created_at datetime
  updated_at datetime

  indexes {
    venue_id
    sport_id
  }
}


// =======================================================
// 10. COURT_SCHEDULES
// Lịch hoạt động của sân
// day_of_week: 1 -> 7
// =======================================================

Table court_schedules {
  id int [pk, increment]

  court_id int [not null]

  day_of_week int [not null]

  open_time time [not null]
  close_time time [not null]

  is_active boolean [default: true]

  created_at datetime
  updated_at datetime

  indexes {
    (court_id, day_of_week) [unique]
  }
}


// =======================================================
// 11. TIME_SLOTS
// =======================================================

Table time_slots {
  id int [pk, increment]

  start_time time [not null]
  end_time time [not null]

  status varchar(30) [default: 'ACTIVE']

  indexes {
    (start_time, end_time) [unique]
  }
}


// =======================================================
// 12. COURT_PRICES
// Giá theo sân + khung giờ
// =======================================================

Table court_prices {
  id int [pk, increment]

  court_id int [not null]
  time_slot_id int [not null]

  day_of_week int

  price decimal(12,2) [not null]

  effective_from date
  effective_to date

  status varchar(30) [default: 'ACTIVE']

  created_at datetime
  updated_at datetime

  indexes {
    court_id
    time_slot_id
  }
}


// =======================================================
// 13. BOOKINGS
// Phiếu đặt sân
// =======================================================

Table bookings {
  id int [pk, increment]

  user_id int [not null]
  voucher_id int

  booking_code varchar(50) [not null, unique]

  booking_date date [not null]

  subtotal decimal(12,2) [not null]
  discount_amount decimal(12,2) [default: 0]
  total_amount decimal(12,2) [not null]

  status varchar(30) [not null, default: 'PENDING']

  note varchar(500)

  created_at datetime [not null]
  updated_at datetime

  indexes {
    user_id
    booking_date
    status
  }
}


// =======================================================
// 14. BOOKING_DETAILS
// Một booking có thể chứa nhiều time slot
// =======================================================

Table booking_details {
  id int [pk, increment]

  booking_id int [not null]

  court_id int [not null]
  time_slot_id int [not null]

  booking_date date [not null]

  unit_price decimal(12,2) [not null]

  created_at datetime

  // Không đặt UNIQUE vì booking Cancelled có thể cần cho đặt lại.
  // Conflict sẽ được Service kiểm tra bằng LINQ.
  indexes {
    (court_id, booking_date, time_slot_id)
    booking_id
  }
}


// =======================================================
// 15. PAYMENTS
// Payment method được gộp thành field thay vì bảng riêng
// =======================================================

Table payments {
  id int [pk, increment]

  booking_id int [not null]
  user_id int [not null]

  payment_method varchar(50) [not null]
  transaction_code varchar(100) [unique]

  amount decimal(12,2) [not null]

  status varchar(30) [default: 'PENDING']

  paid_at datetime

  created_at datetime [not null]
  updated_at datetime

  indexes {
    booking_id
    user_id
    status
  }
}


// =======================================================
// 16. VOUCHERS
// =======================================================

Table vouchers {
  id int [pk, increment]

  created_by int

  code varchar(50) [not null, unique]

  name varchar(150)
  description varchar(500)

  discount_type varchar(30) [not null]
  discount_value decimal(12,2) [not null]

  min_order_amount decimal(12,2) [default: 0]
  max_discount_amount decimal(12,2)

  start_at datetime [not null]
  end_at datetime [not null]

  usage_limit int
  per_user_limit int [default: 1]

  status varchar(30) [default: 'ACTIVE']

  created_at datetime
  updated_at datetime
}


// =======================================================
// 17. VOUCHER_USAGES
// =======================================================

Table voucher_usages {
  id int [pk, increment]

  voucher_id int [not null]
  user_id int [not null]
  booking_id int [not null]

  discount_amount decimal(12,2) [not null]

  used_at datetime [not null]

  indexes {
    (voucher_id, user_id, booking_id) [unique]
    user_id
  }
}


// =======================================================
// 18. REVIEWS
// User chỉ review sau booking hoàn tất
// =======================================================

Table reviews {
  id int [pk, increment]

  user_id int [not null]
  court_id int [not null]
  booking_id int [not null]

  rating int [not null]
  comment text

  status varchar(30) [default: 'VISIBLE']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    booking_id [unique]
    court_id
    user_id
  }
}


// =======================================================
// 19. TEAMS
// =======================================================

Table teams {
  id int [pk, increment]

  owner_user_id int [not null]
  sport_id int [not null]

  name varchar(150) [not null]

  description text
  logo_url varchar(500)

  status varchar(30) [default: 'ACTIVE']

  created_at datetime
  updated_at datetime

  indexes {
    owner_user_id
    sport_id
  }
}


// =======================================================
// 20. TEAM_MEMBERS
// =======================================================

Table team_members {
  id int [pk, increment]

  team_id int [not null]
  user_id int [not null]

  team_role varchar(50) [default: 'MEMBER']
  status varchar(30) [default: 'ACTIVE']

  joined_at datetime

  indexes {
    (team_id, user_id) [unique]
  }
}


// =======================================================
// 21. TOURNAMENTS
// =======================================================

Table tournaments {
  id int [pk, increment]

  sport_id int [not null]
  venue_id int

  created_by int [not null]

  name varchar(200) [not null]
  description text

  start_date date [not null]
  end_date date [not null]

  registration_start date
  registration_end date

  max_teams int

  entry_fee decimal(12,2) [default: 0]

  status varchar(30) [default: 'UPCOMING']

  created_at datetime
  updated_at datetime

  indexes {
    sport_id
    venue_id
    status
  }
}


// =======================================================
// 22. TOURNAMENT_TEAMS
// =======================================================

Table tournament_teams {
  id int [pk, increment]

  tournament_id int [not null]
  team_id int [not null]

  registration_status varchar(30) [default: 'PENDING']

  seed_number int

  registered_at datetime

  indexes {
    (tournament_id, team_id) [unique]
  }
}


// =======================================================
// 23. TOURNAMENT_ROUNDS
// =======================================================

Table tournament_rounds {
  id int [pk, increment]

  tournament_id int [not null]

  round_number int [not null]

  name varchar(100)

  status varchar(30) [default: 'PENDING']

  start_date date
  end_date date

  created_at datetime

  indexes {
    (tournament_id, round_number) [unique]
  }
}


// =======================================================
// 24. MATCHES
// =======================================================

Table matches {
  id int [pk, increment]

  tournament_id int [not null]
  round_id int [not null]

  court_id int

  team1_id int
  team2_id int

  scheduled_date date

  start_time time
  end_time time

  team1_score int [default: 0]
  team2_score int [default: 0]

  winner_team_id int

  status varchar(30) [default: 'SCHEDULED']

  created_at datetime
  updated_at datetime

  // Conflict thời gian xử lý bằng LINQ/Service.
  indexes {
    (court_id, scheduled_date, start_time, end_time)
    tournament_id
    round_id
  }
}


// =======================================================
// RELATIONSHIPS
// =======================================================


// ---------- USER / AUTH ----------

Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id

Ref: role_permissions.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id

Ref: user_profiles.user_id > users.id


// ---------- SPORT / VENUE / COURT ----------

Ref: venues.owner_id > users.id

Ref: courts.venue_id > venues.id
Ref: courts.sport_id > sports.id


// ---------- SCHEDULE / PRICE ----------

Ref: court_schedules.court_id > courts.id

Ref: court_prices.court_id > courts.id
Ref: court_prices.time_slot_id > time_slots.id


// ---------- BOOKING ----------

Ref: bookings.user_id > users.id
Ref: bookings.voucher_id > vouchers.id

Ref: booking_details.booking_id > bookings.id
Ref: booking_details.court_id > courts.id
Ref: booking_details.time_slot_id > time_slots.id


// ---------- PAYMENT ----------

Ref: payments.booking_id > bookings.id
Ref: payments.user_id > users.id


// ---------- VOUCHER ----------

Ref: vouchers.created_by > users.id

Ref: voucher_usages.voucher_id > vouchers.id
Ref: voucher_usages.user_id > users.id
Ref: voucher_usages.booking_id > bookings.id


// ---------- REVIEW ----------

Ref: reviews.user_id > users.id
Ref: reviews.court_id > courts.id
Ref: reviews.booking_id > bookings.id


// ---------- TEAM ----------

Ref: teams.owner_user_id > users.id
Ref: teams.sport_id > sports.id

Ref: team_members.team_id > teams.id
Ref: team_members.user_id > users.id


// ---------- TOURNAMENT ----------

Ref: tournaments.sport_id > sports.id
Ref: tournaments.venue_id > venues.id
Ref: tournaments.created_by > users.id

Ref: tournament_teams.tournament_id > tournaments.id
Ref: tournament_teams.team_id > teams.id

Ref: tournament_rounds.tournament_id > tournaments.id


// ---------- MATCH ----------

Ref: matches.tournament_id > tournaments.id
Ref: matches.round_id > tournament_rounds.id

Ref: matches.court_id > courts.id

Ref: matches.team1_id > teams.id
Ref: matches.team2_id > teams.id
Ref: matches.winner_team_id > teams.id
