// =======================================================
// 1. USERS
// =======================================================
Table users {
  id bigint [pk, increment]

  username varchar(100) [not null, unique]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]

  status varchar(30) [not null, default: 'ACTIVE']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    username
    email
    status
  }
}


// =======================================================
// 2. ROLES
// =======================================================
Table roles {
  id bigint [pk, increment]

  name varchar(50) [not null, unique]
  description varchar(255)

  created_at datetime [not null]
}


// =======================================================
// 3. PERMISSIONS
// Quyền chi tiết để demo @PreAuthorize / hasAuthority
// =======================================================
Table permissions {
  id bigint [pk, increment]

  code varchar(100) [not null, unique]
  description varchar(255)

  created_at datetime [not null]
}


// =======================================================
// 4. USER_ROLES
// Composite key phù hợp @EmbeddedId
// =======================================================
Table user_roles {
  user_id bigint [not null]
  role_id bigint [not null]

  created_at datetime [not null]

  indexes {
    (user_id, role_id) [pk]
    role_id
  }
}


// =======================================================
// 5. ROLE_PERMISSIONS
// Composite key phù hợp @EmbeddedId
// =======================================================
Table role_permissions {
  role_id bigint [not null]
  permission_id bigint [not null]

  created_at datetime [not null]

  indexes {
    (role_id, permission_id) [pk]
    permission_id
  }
}


// =======================================================
// 6. USER_PROFILES
// =======================================================
Table user_profiles {
  id bigint [pk, increment]

  user_id bigint [not null, unique]

  full_name varchar(150)
  phone varchar(20)
  gender varchar(20)
  date_of_birth date

  avatar_url varchar(500)
  address varchar(255)
  city varchar(100)

  created_at datetime [not null]
  updated_at datetime
}


// =======================================================
// 7. SPORTS
// =======================================================
Table sports {
  id bigint [pk, increment]

  name varchar(100) [not null, unique]
  description varchar(500)
  icon_url varchar(500)

  status varchar(30) [not null, default: 'ACTIVE']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    name
    status
  }
}


// =======================================================
// 8. VENUES
// Cơ sở thể thao do OWNER quản lý
// =======================================================
Table venues {
  id bigint [pk, increment]

  owner_id bigint [not null]

  name varchar(200) [not null]
  description varchar(1000)
  image_url varchar(500)

  address varchar(255) [not null]
  district varchar(100)
  city varchar(100)

  latitude decimal(10,7)
  longitude decimal(10,7)

  phone varchar(20)

  status varchar(30) [not null, default: 'ACTIVE']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    owner_id
    status
    (city, district)
  }
}


// =======================================================
// 9. COURTS
// Gộp giá cơ bản vào court để bỏ court_prices/time_slots
// =======================================================
Table courts {
  id bigint [pk, increment]

  venue_id bigint [not null]
  sport_id bigint [not null]

  name varchar(150) [not null]
  description varchar(1000)
  image_url varchar(500)

  court_type varchar(100)
  capacity int

  price_per_hour decimal(12,2) [not null]

  status varchar(30) [not null, default: 'AVAILABLE']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    venue_id
    sport_id
    status
    (venue_id, sport_id, status)
  }
}


// =======================================================
// 10. COURT_SCHEDULES
// Lịch mở cửa theo thứ trong tuần
// =======================================================
Table court_schedules {
  id bigint [pk, increment]

  court_id bigint [not null]

  day_of_week int [not null]
  open_time time [not null]
  close_time time [not null]

  is_active boolean [not null, default: true]

  created_at datetime [not null]
  updated_at datetime

  indexes {
    (court_id, day_of_week) [unique]
  }
}


// =======================================================
// 11. BOOKINGS
// Gộp booking_details + time_slots:
// mỗi booking MVP đặt 1 court trong 1 khoảng thời gian
// =======================================================
Table bookings {
  id bigint [pk, increment]

  user_id bigint [not null]
  court_id bigint [not null]

  booking_code varchar(50) [not null, unique]

  booking_date date [not null]
  start_time time [not null]
  end_time time [not null]

  unit_price decimal(12,2) [not null]
  total_amount decimal(12,2) [not null]

  status varchar(30) [not null, default: 'PENDING']
  note varchar(500)

  created_at datetime [not null]
  updated_at datetime

  indexes {
    user_id
    court_id
    booking_date
    status

    // Dùng query Service kiểm tra overlap thời gian.
    (court_id, booking_date, start_time, end_time)
  }
}


// =======================================================
// 12. PAYMENTS
// Payment mock - 1 payment chính cho 1 booking
// =======================================================
Table payments {
  id bigint [pk, increment]

  booking_id bigint [not null, unique]

  payment_method varchar(50) [not null]
  transaction_code varchar(100) [unique]

  amount decimal(12,2) [not null]

  status varchar(30) [not null, default: 'PENDING']
  paid_at datetime

  created_at datetime [not null]
  updated_at datetime

  indexes {
    status
  }
}


// =======================================================
// 13. REVIEWS
// Mỗi booking chỉ review tối đa 1 lần
// =======================================================
Table reviews {
  id bigint [pk, increment]

  user_id bigint [not null]
  court_id bigint [not null]
  booking_id bigint [not null, unique]

  rating int [not null]
  comment text

  status varchar(30) [not null, default: 'VISIBLE']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    court_id
    user_id
    rating
  }
}


// =======================================================
// 14. TEAMS
// =======================================================
Table teams {
  id bigint [pk, increment]

  owner_user_id bigint [not null]
  sport_id bigint [not null]

  name varchar(150) [not null]
  description varchar(1000)
  logo_url varchar(500)

  status varchar(30) [not null, default: 'ACTIVE']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    owner_user_id
    sport_id
    status
  }
}


// =======================================================
// 15. TEAM_MEMBERS
// =======================================================
Table team_members {
  id bigint [pk, increment]

  team_id bigint [not null]
  user_id bigint [not null]

  team_role varchar(50) [not null, default: 'MEMBER']
  status varchar(30) [not null, default: 'ACTIVE']

  joined_at datetime [not null]

  indexes {
    (team_id, user_id) [unique]
    user_id
  }
}


// =======================================================
// 16. TOURNAMENTS
// =======================================================
Table tournaments {
  id bigint [pk, increment]

  sport_id bigint [not null]
  venue_id bigint
  created_by bigint [not null]

  name varchar(200) [not null]
  description varchar(1000)

  start_date date [not null]
  end_date date [not null]

  registration_start date
  registration_end date

  max_teams int

  status varchar(30) [not null, default: 'UPCOMING']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    sport_id
    venue_id
    created_by
    status
    (start_date, end_date)
  }
}


// =======================================================
// 17. TOURNAMENT_TEAMS
// =======================================================
Table tournament_teams {
  id bigint [pk, increment]

  tournament_id bigint [not null]
  team_id bigint [not null]

  registration_status varchar(30) [not null, default: 'PENDING']
  seed_number int

  registered_at datetime [not null]

  indexes {
    (tournament_id, team_id) [unique]
    team_id
  }
}


// =======================================================
// 18. MATCHES
// Gộp tournament_rounds bằng round_number
// =======================================================
Table matches {
  id bigint [pk, increment]

  tournament_id bigint [not null]
  round_number int [not null]

  court_id bigint

  team1_id bigint
  team2_id bigint

  scheduled_date date
  start_time time
  end_time time

  team1_score int [not null, default: 0]
  team2_score int [not null, default: 0]

  winner_team_id bigint

  status varchar(30) [not null, default: 'SCHEDULED']

  created_at datetime [not null]
  updated_at datetime

  indexes {
    tournament_id
    (tournament_id, round_number)
    (court_id, scheduled_date, start_time, end_time)
  }
}


// =======================================================
// RELATIONSHIPS
// =======================================================

// ---------- AUTH ----------
Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id

Ref: role_permissions.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id

Ref: user_profiles.user_id > users.id


// ---------- VENUE / COURT ----------
Ref: venues.owner_id > users.id

Ref: courts.venue_id > venues.id
Ref: courts.sport_id > sports.id

Ref: court_schedules.court_id > courts.id


// ---------- BOOKING ----------
Ref: bookings.user_id > users.id
Ref: bookings.court_id > courts.id

Ref: payments.booking_id > bookings.id

Ref: reviews.user_id > users.id
Ref: reviews.court_id > courts.id
Ref: reviews.booking_id > bookings.id


// ---------- TEAM ----------
Ref: teams.owner_user_id > users.id
Ref: teams.sport_id > sports.id

Ref: team_members.team_id > teams.id
Ref: team_members.user_id > users.id


// ---------- TOURNAMENT ----------
Ref: tournaments.sport_id > sports.id
Ref: tournaments.venue_id > venues.id
Ref: tournaments.created_by > users.id

Ref: tournament_teams.tournament_id > tournaments.id
Ref: tournament_teams.team_id > teams.id


// ---------- MATCH ----------
Ref: matches.tournament_id > tournaments.id
Ref: matches.court_id > courts.id

Ref: matches.team1_id > teams.id
Ref: matches.team2_id > teams.id
Ref: matches.winner_team_id > teams.id
